{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "assignment01-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "assignment_01/app/frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "assignment02-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "assignment_02/app/frontend", "run", "dev", "--", "--port", "5180", "--strictPort"],
      "port": 5180
    },
    {
      "name": "assignment02-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--reload", "--port", "8001", "--app-dir", "assignment_02/app/backend"],
      "port": 8001
    },
    {
      "name": "cb-api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "api.main:app", "--port", "8000"],
      "cwd": "assignment_02/customer_behaviour",
      "port": 8000
    },
    {
      "name": "cb-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "assignment_02/customer_behaviour/web", "run", "dev"],
      "port": 5174
    }
  ]
}
